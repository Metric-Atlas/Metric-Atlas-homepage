# GA4 Measurement ID (e.g. G-XXXXXXXXXX). Found in GA4 Admin > Data Streams.
# Leave empty to run in demo mode — gtag() calls still fire (for Metric
# Atlas's static code detection) but nothing is sent to Google.
VITE_GA_MEASUREMENT_ID=

# Mixpanel Project Token. Found in Mixpanel > Project Settings > Access Keys.
# Leave empty to run in demo mode — mixpanel.track() calls are logged to
# the console instead of being sent.
VITE_MIXPANEL_TOKEN=
